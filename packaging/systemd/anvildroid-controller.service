[Unit]
Description=AnvilDroid runtime controller (headless preview)
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -B /usr/local/lib/anvildroid-controller/runtime-controller.py --store /var/lib/anvildroid-controller --socket /run/anvildroid/control.sock
User=root
UMask=0077
Delegate=yes
StateDirectory=anvildroid-controller
StateDirectoryMode=0700
RuntimeDirectory=anvildroid
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONNOUSERSITE=1
Restart=on-failure
RestartSec=3
# Workers own private namespaces and survive controller restarts. Stop each
# runtime through the API before stopping/removing the service intentionally.
# Workers own the LXC namespace. Kill the whole service cgroup on controller
# restart so an interrupted start cannot leave an orphan worker holding the
# runtime in "Starting" forever.
KillMode=control-group
TimeoutStopSec=240

[Install]
WantedBy=multi-user.target
