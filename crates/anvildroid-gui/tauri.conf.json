{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnvilDroid",
  "identifier": "org.anvildroid.gui",
  "build": {
    "frontendDist": "./src-frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AnvilDroid",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "decorations": true,
        "visible": false,
        "center": true,
        "minWidth": 900,
        "minHeight": 600,
        "transparent": true,
        "backgroundColor": "#00000000"
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}
